# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/kavach?retryWrites=true&w=majority
# For local MongoDB: mongodb://localhost:27017/kavach
# If Atlas fails with querySrv ECONNREFUSED, Node DNS is broken — force public resolvers:
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
# Password special chars must be URL-encoded (@ → %40, # → %23, etc.)

# JWT Configuration (REQUIRED - Server will not start without JWT_SECRET)
# CRITICAL: Generate a strong secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Minimum 32 characters recommended for security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-MUST-BE-AT-LEAST-32-CHARACTERS
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Redis / Upstash (optional — leaderboards/cache fall back to MongoDB)
# Preferred for this project: Upstash REST tab values
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_token
# Optional TCP instead (local or Upstash TCP tab with rediss://):
# REDIS_URL=rediss://default:PASSWORD@xxxx.upstash.io:6379
# REDIS_URL=redis://localhost:6379

# Firebase Configuration
FIREBASE_SERVER_KEY=your-firebase-server-key

# MQTT Configuration (for IoT)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=

# AWS S3 Configuration (Optional)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_BUCKET_NAME=kavach-uploads
AWS_REGION=ap-south-1

# Google Maps API
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Gemini AI (Add-on 3)
GEMINI_API_KEY=your-gemini-api-key

# CORS Origins
# CORS: web origin(s). Comma-separated. Add your tunnel URL here when using Dev Tunnels.
CORS_ORIGIN=http://localhost:3001,http://localhost:3000

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Phase 3.4.4: Security & Compliance
# Encryption key (64 hex characters / 32 bytes) - RECOMMENDED for production
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If not set, a random key will be generated on each restart (data encrypted with old key becomes unreadable)
# ENCRYPTION_KEY=your-64-character-hex-encryption-key-here

# Phase 3.4.3: Communication Services (Optional)
# Email — Resend preferred (then SendGrid, then SMTP)
# RESEND_API_KEY=re_xxxx
# RESEND_FROM_EMAIL=Kavach <onboarding@resend.dev>
# After verifying a domain: RESEND_FROM_EMAIL=Kavach <noreply@yourdomain.com>
# SENDGRID_API_KEY=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=noreply@kavach.com

# SMS (Twilio) — optional; push + email cover demos without it
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# IoT sensors / ESP32 / mesh (default false — no sensor ingest until ready)
# Set IOT_ENABLED=true and restart when hardware is connected
IOT_ENABLED=false

# NDMA/IMD national feed polling (default false — enable when feed URLs work)
NDMA_ENABLED=false