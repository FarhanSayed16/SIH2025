# Next.js Web Dashboard Environment Variables

# API Configuration
# Backend API base URL (without /api suffix)
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Socket.io Server URL (without /api suffix)
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# Alternative API Base URL (used in some components)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# Environment
NODE_ENV=development

# Mapbox Configuration (for /map page)
# Get your token from https://account.mapbox.com/ (create a free account)
# Use either variable name (both work):
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-public-token
# NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your-mapbox-public-token
