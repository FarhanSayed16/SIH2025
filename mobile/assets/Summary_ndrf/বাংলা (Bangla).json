<<<<<<< HEAD
{
    "দুর্যোগ ব্যবস্থাপনা এবং প্রস্তুতি (DM AND PREPAPAREDNESS)": "দুর্যোগ ব্যবস্থাপনা (DM)-কে চারটি প্রধান পর্যায়ে সরল করা হয়েছে: হ্রাসকরণ (Mitigation), প্রস্তুতি (Preparedness), প্রতিক্রিয়া (Response), এবং পুনরুদ্ধার (Recovery)। এই মডিউলটি ভারতের নির্দিষ্ট দুর্বলতাগুলি তুলে ধরে এবং দেশের সুরক্ষার জন্য আইনি ভিত্তি—DM আইন 2005—এবং NDMA ও NDRF-এর মতো প্রধান সংস্থাগুলিকে পরিচয় করিয়ে দেয়, যারা এই প্রচেষ্টার নেতৃত্ব দেয়। সবচেয়ে গুরুত্বপূর্ণ, এটি আপনার পরিবারকে যেকোনো সংকটের জন্য প্রস্তুত করার জন্য সহজ, ব্যবহারিক পদক্ষেপ সরবরাহ করে, যেমন পালানোর পথ পরিকল্পনা করা এবং একটি সারভাইভাল কিট একত্রিত করা।",
    "ভূমিকম্প (EARTHQUAKE)": "এই শিক্ষামূলক ভিডিওটি অসমীয়া ভাষায় ভূমিকম্পের উপর একটি গভীর নির্দেশিকা। এটি বৈজ্ঞানিক কারণ (চলমান টেকটোনিক প্লেট), কীভাবে ভূমিকম্পের তীব্রতা রিখটার স্কেলে পরিমাপ করা হয়, এবং এর ভূমিকম্প অঞ্চলগুলির (Seismic Zones) মাধ্যমে ভারতের ঝুঁকি প্রোফাইল ব্যাখ্যা করে। সবচেয়ে গুরুত্বপূর্ণ, ভিডিওটি ব্যাপক নিরাপত্তা নির্দেশাবলী প্রদান করে—একটি ভূকম্পনজনিত ঘটনার ঠিক আগে, সময়কালে (নত হোন, ঢেকে নিন এবং ধরে রাখুন - Drop, Cover, and Hold On), এবং পরে বিভিন্ন পরিবেশে কী করতে হবে।",
    "ভূমিধস (LANDSLIDE)": "অসমীয়া ভাষায় উপস্থাপিত এই শিক্ষামূলক ভিডিওটি ভূমিধসের উপর একটি ব্যাপক নির্দেশিকা। এটি ভূমিধসের সংজ্ঞা দেয়, তাদের ছয়টি শ্রেণীতে বিভক্ত করে এবং দ্বৈত কারণগুলি ব্যাখ্যা করে: প্রাকৃতিক কারণ (যেমন ভারী বৃষ্টি এবং ভূমিকম্প) এবং মানুষের কার্যকলাপ (যেমন বন উজাড় এবং খনন)। ভিডিওটি ভূমিধসের কারণে হওয়া গুরুতর ক্ষতির বিবরণ দেয় এবং রিটেইনিং ওয়াল তৈরি করা এবং বনায়ন-এর মতো হ্রাসকরণ (Mitigation) কৌশলগুলির উপর জোর দেয়। সবচেয়ে গুরুত্বপূর্ণভাবে, ভূমিধসের আগে (প্রস্তুতি নিন), সময়কালে (উঁচু ভূমিতে সরিয়ে যান), এবং পরে কী করতে হবে তার একটি সম্পূর্ণ নিরাপত্তা নির্দেশিকা এটি প্রদান করে।",
    "বন্যা (FLOOD)": "এই শিক্ষামূলক ভিডিওটি বন্যার (Ban Pani) জন্য একটি গুরুত্বপূর্ণ নির্দেশিকা। এটি এর কারণগুলি (ভারী বৃষ্টিপাত, দুর্বল নিষ্কাশন), প্রকারগুলি (আকস্মিক বন্যা - Flash Floods, নদীর উপচে পড়া), এবং বন্যার গুরুতর প্রভাবগুলি চিহ্নিত করে। ভিডিওটি মূল সুরক্ষা কৌশলগুলির উপর জোর দেয়: একটি জরুরী কিট প্রস্তুত করা, বাঁধ (embankments) এর মতো হ্রাসকরণ কৌশলগুলি ব্যবহার করা, এবং সবচেয়ে গুরুত্বপূর্ণভাবে, বন্যার সময়কালে অবিলম্বে উঁচু ভূমিতে সরে যাওয়ার মাধ্যমে বন্যার জল এড়ানোর জীবন রক্ষাকারী নিয়ম অনুসরণ করা।",
    "সুনামি (TSUNAMI)": "এই ভিডিওটি সুনামি বোঝা এবং সেগুলোর হাত থেকে বাঁচার জন্য আপনার অপরিহার্য নির্দেশিকা। এটি এই বিশাল, জীবনঘাতী তরঙ্গগুলির পেছনের বিজ্ঞানকে ভেঙে দেয়, ব্যাখ্যা করে যে তারা প্রধানত টেকটোনিক প্লেট সরানোর কারণে সৃষ্ট বিশাল পানির নিচের ভূমিকম্পের ফলে হয়। সবচেয়ে বড় শিক্ষা? আপনাকে প্রাকৃতিক সতর্কীকরণ সংকেত জানতে হবে। আপনি উপকূলের কাছাকাছি থাকলে এবং সমুদ্রের জল হঠাৎ পিছিয়ে গেলে (টেনে নিলে), উঁচু ভূমিতে দৌড়ানোর জন্য এটি আপনার তাৎক্ষণিক, জীবন রক্ষাকারী সংকেত! সরকারি সতর্কতার জন্য অপেক্ষা করবেন না।",
    "ঘূর্ণিঝড় (Cyclone)": "এই ভিডিওটি ঘূর্ণিঝড়ের (Ghurṇibataha) জন্য একটি সংক্ষিপ্ত কিন্তু গুরুত্বপূর্ণ নির্দেশিকা প্রদান করে। এটি ক্রান্তীয় ঘূর্ণিঝড় গঠন এবং এর ধ্বংসাত্মক প্রকৃতিকে অন্তর্ভুক্ত করে, শক্তিশালী বাতাস এবং ঝড় বৃদ্ধির (storm surges) মাধ্যমে তাদের প্রভাব ব্যাখ্যা করে। এই মডিউলটি বিপদ ট্র্যাক করতে ব্যবহৃত চার-পর্যায়ের জাতীয় সতর্কীকরণ ব্যবস্থার বিবরণ দেয়। সবচেয়ে গুরুত্বপূর্ণ, এটি প্রস্তুতির উপর স্পষ্ট নির্দেশাবলী দেয়: প্রথমে আপনার বাড়িকে সুরক্ষিত করা, ঝড়ের \"চোখ\" চলাকালীন আপনার আশ্রয় ছেড়ে না যাওয়ার গুরুত্বপূর্ণ সতর্কতা, এবং ঘূর্ণিঝড় পেরিয়ে যাওয়ার পরে কী কী পদক্ষেপ নিতে হবে।",
    "মেঘভাঙা বৃষ্টি (CLOUDBURST)": "এটি মেঘভাঙা বৃষ্টিকে একটি সীমিত এলাকায় এক ঘন্টায় 100mm বৃষ্টির দ্রুত সঞ্চয় হিসাবে সংজ্ঞায়িত করে, ব্যাখ্যা করে যে এটি আটকে পড়া এবং ভেঙে পড়া তীব্র আর্দ্রতার কারণে ঘটে। তাৎক্ষণিক এবং সবচেয়ে গুরুতর বিপদ হলো এই ঘটনাগুলি হঠাৎ, বিপর্যয়মূলক আকস্মিক বন্যা (Flash Floods) এবং ভূমিধস সৃষ্টি করে। এই মডিউলটি সম্পূর্ণভাবে তাৎক্ষণিক সুরক্ষার উপর দৃষ্টি নিবদ্ধ করে: এটি হ্রাসকরণের (যেমন গাছ লাগানো) প্রয়োজনীয়তা এবং সরকারি সতর্কতার জন্য অপেক্ষা না করে, ভারী বৃষ্টির প্রথম লক্ষণগুলিতেই উঁচু ভূমিতে তাৎক্ষণিক সরিয়ে নেওয়ার গুরুত্বপূর্ণ পদক্ষেপের উপর জোর দেয়।",
    "বজ্রপাত ও ঝড় (LIGHTNING AND THUNDERSTORM)": "এই ভিডিওটি বজ্রপাত এবং ঝড়ের (Hawa-o Bijli) হাত থেকে বাঁচার জন্য একটি সংক্ষিপ্ত এবং গুরুত্বপূর্ণ নির্দেশিকা প্রদান করে। ⚡ এটি বিজ্ঞানকে স্পষ্টভাবে ব্যাখ্যা করে, বিদ্যুৎ (electrical strike) এবং বজ্র (sonic boom) এর মধ্যে পার্থক্য করে। মডিউলটির মূল অংশ সুরক্ষার উপর দৃষ্টি নিবদ্ধ করে, 30/30 নিয়ম ব্যবহারের উপর জোর দেয়: আপনি যদি বিদ্যুৎ দেখতে পান এবং 30 সেকেন্ডের মধ্যে বজ্রপাত শুনতে পান, তবে অবিলম্বে একটি নিরাপদ আশ্রয় (যেমন একটি আবদ্ধ ভবন বা বন্ধ গাড়ি) খুঁজুন এবং শেষ বজ্রপাতের পরে 30 মিনিট পর্যন্ত সেই আশ্রয়টি ছেড়ে যাবেন না। এটি বাড়ির ভেতরে থাকাকালীনও জল, কর্ডযুক্ত ফোন এবং কংক্রিটের মেঝেগুলির মতো পরিবাহী (conductive) উপাদান ব্যবহার না করার বিষয়ে সতর্ক করে।",
    "খরা (DROUGHT)": "এটি খরাকে অপর্যাপ্ত বৃষ্টিপাতের একটি দীর্ঘ সময়কাল হিসাবে সংজ্ঞায়িত করে যা একটি গুরুত্বপূর্ণ জলবাহী ভারসাম্যহীনতা (hydrological imbalance) সৃষ্টি করে, যার ফলে জলের ঘাটতি, ফসলের ক্ষতি এবং মাটির আর্দ্রতা হ্রাস পায়। মডিউলটি তখন খরার চারটি ভিন্ন প্রকারের— আবহাওয়াগত (Meteorological), কৃষিগত (Agricultural), জলবাহী (Hydrological), এবং সামাজিক-অর্থনৈতিক (Socio-economic)—বিবরণ দেয়, যা জীবনের বিভিন্ন দিকগুলিতে জলের ঘাটতির অগ্রগতি এবং প্রভাব বর্ণনা করে। সবচেয়ে গুরুত্বপূর্ণভাবে, ভিডিওটি সক্রিয় সমাধানের উপর মনোযোগ দেয়, শুষ্ক অবস্থার প্রভাব কমাতে ইনডোর এবং আউটডোর জল সংরক্ষণের পদ্ধতিগুলির উপর ব্যাপক, ব্যবহারিক পরামর্শ প্রদান করে, যা ছোট, দৈনন্দিন পরিবর্তনগুলির উপর জোর দেয় যা সম্মিলিতভাবে উল্লেখযোগ্য পরিমাণে জল বাঁচায়।",
    "তাপপ্রবাহ (Heat Wave)": "এই মডিউলটি তাপপ্রবাহকে (Heat Wave) অতিরিক্ত উচ্চ তাপমাত্রার সময়কাল হিসাবে সংজ্ঞায়িত করে, এর কারণ এবং হিট স্ট্রোক এবং পানিশূন্যতা (dehydration) এর মতো বিপজ্জনক স্বাস্থ্য প্রভাবগুলির বিবরণ দেয়। এটি গুরুত্বপূর্ণ সুরক্ষা ব্যবস্থার উপর দৃষ্টি নিবদ্ধ করে, যা তাপপ্রবাহের আগে, সময়কালে এবং পরে কী করতে হবে তা অন্তর্ভুক্ত করে, যেমন হাইড্রেটেড থাকা, হালকা কাপড় পরা এবং চরম সময়ের মধ্যে বাইরের কার্যকলাপ এড়ানো। লক্ষ্য সহজ: বিপদ চিনতে শিখুন এবং চরম গরম থেকে নিজেকে রক্ষা করুন।",
    "শৈত্যপ্রবাহ (Cold Wave)": "এই ভিডিওটি চরম ঠান্ডার প্রাণঘাতী প্রভাবগুলি সনাক্ত করা এবং তা থেকে কীভাবে বাঁচা যায় সে সম্পর্কে। এটি একটি শৈত্যপ্রবাহকে (Cold Wave) সংজ্ঞায়িত করে, এটি কীভাবে তৈরি হয় এবং হাইপোথার্মিয়া এবং ফ্রস্টবাইট (তুষারক্ষত)-এর মতো গুরুতর স্বাস্থ্য ঝুঁকিগুলি কভার করে। মডিউলটি প্রয়োজনীয় সুরক্ষামূলক ব্যবস্থা প্রদান করে, যার মধ্যে পোশাকের সঠিক স্তর, নিজের এবং অন্যের মধ্যে ঠান্ডা-সম্পর্কিত অসুস্থতার প্রাথমিক লক্ষণগুলি সনাক্ত করা, এবং একটি নিরাপদ, উষ্ণ আশ্রয় কখন এবং কীভাবে খুঁজতে হবে তা অন্তর্ভুক্ত।",
    "মৌলিক অনুসন্ধান ও উদ্ধার (Basic Search & Rescue)": "এই মডিউলটি দুর্যোগের সময় জীবন বাঁচানোর মূল নীতিগুলির সাথে আপনার পরিচয় করিয়ে দেয়। এটি একটি অনুসন্ধান এলাকা সংগঠিত করা, বিভিন্ন অনুসন্ধান প্যাটার্ন বোঝা, মৌলিক সরঞ্জাম ব্যবহার করা এবং ক্ষতিগ্রস্থদের অগ্রাধিকার দেওয়া-এর মতো প্রয়োজনীয় দক্ষতাগুলি কভার করে। মূল শিক্ষাটি হলো সুসংগঠিত কর্ম: ধসে পড়া কাঠামোর মতো বিপজ্জনক পরিবেশ থেকে ক্ষতিগ্রস্থদের নিরাপদে এবং দক্ষতার সাথে সনাক্ত করা, স্থিতিশীল করা এবং বের করে আনা শিখুন।",
    "ভার উত্তোলন এবং স্থিতিশীল করা (Lifting and Stabilising Load)": "এই প্রযুক্তিগত মডিউলটি উদ্ধার পরিস্থিতিতে ভারী জিনিসগুলি নিরাপদে পরিচালনা করার গুরুত্বপূর্ণ, প্রায়শই বিপজ্জনক দক্ষতা শেখায়। এটি উত্তোলনের পদার্থবিজ্ঞান, যান্ত্রিক সহায়তা (লিভার এবং সাধারণ কপিকল মতো) ব্যবহার, এবং, সবচেয়ে গুরুত্বপূর্ণভাবে, সেকেন্ডারি পতন এবং ক্ষতিগ্রস্থ এবং উদ্ধারকারী উভয়ের আরও আঘাত রোধ করতে একটি অস্থির লোডকে স্থিতিশীল করা (ক্রিবিং বা শোরিং ব্যবহার করে) অন্তর্ভুক্ত করে।",
    "সম্প্রদায় ভিত্তিক স্বাস্থ্য এবং প্রাথমিক চিকিৎসা (Community Based Health & First Aid)": "এই ব্যাপক মডিউলটি সম্প্রদায়ের পরিবেশে ব্যবহারিক প্রয়োগের উপর মনোযোগ দিয়ে, দৈনন্দিন জরুরি অবস্থার জন্য প্রয়োজনীয় মৌলিক প্রাথমিক চিকিৎসার দক্ষতা শেখায়। এতে ক্ষত পরিচর্যা, পোড়া ব্যবস্থাপনা, আঘাতের মূল্যায়ন, এবং পেশাদার সাহায্য আসার আগে প্রতিবেশী এবং পরিবারকে সাহায্য করার জন্য একটি সমন্বিত স্থানীয় প্রতিক্রিয়া সংগঠিত করা অন্তর্ভুক্ত।",
    "নরম টিস্যুর আঘাত (Soft Tissue Injuries)": "এই কেন্দ্রীভূত মডিউলটি ত্বক, পেশী, টেন্ডন এবং লিগামেন্টের সাথে জড়িত সাধারণ আঘাতগুলির মূল্যায়ন এবং তাৎক্ষণিক চিকিৎসা কভার করে। এটি মচকে যাওয়া এবং টান ধরার জন্য স্ট্যান্ডার্ড RICE প্রোটোকল (বিশ্রাম, বরফ, সংকোচন, উন্নতকরণ - Rest, Ice, Compression, Elevation), সেইসাথে সংক্রমণ রোধ করার জন্য খোলা ক্ষত এবং ঘর্ষণগুলির জন্য সঠিক পরিষ্কার এবং ব্যান্ডেজ করার কৌশল শেখায়।",
    "পেশী-কঙ্কাল আঘাত (Musculoskeletal Injury)": "এই মডিউলটি হাড় এবং জয়েন্টের আঘাত, যেমন ফ্র্যাকচার এবং স্থানচ্যুতি (dislocations) শনাক্ত করা এবং পরিচালনা করার বিষয়ে বিস্তারিত নির্দেশাবলী সরবরাহ করে। এটি আহত অঙ্গকে সুরক্ষিত করতে, ব্যথা কমাতে, এবং পরিবহণের সময় আরও ক্ষতি রোধ করতে স্লিংস এবং স্প্লিন্ট (এমনকি অস্থায়ী সরঞ্জাম) ব্যবহার করে অসাড় করা (immobilization) এর মতো গুরুত্বপূর্ণ দক্ষতা শেখায়।",
    "মৌলিক জীবন সমর্থন (Basic Life Support)": "তাৎক্ষণিক জীবন রক্ষাকারী দক্ষতার উপর এটি সবচেয়ে গুরুত্বপূর্ণ মডিউল। পেশাদার সাহায্য না আসা পর্যন্ত জীবন বজায় রাখার জন্য প্রয়োজনীয় কর্মের মূল ক্রমটি এটি শেখায়, কার্ডিওপালমোনারি রিসাসিটেশন (CPR) এবং শ্বাসরোধ এবং আকস্মিক কার্ডিয়াক অ্যারেস্টের মতো পরিস্থিতিগুলি সনাক্ত করা এবং পরিচালনা করার উপর ভারী মনোযোগ কেন্দ্রীভূত করে।",
    "রোগীকে তোলা ও সরানো (Lifting & Moving Patient)": "এই মডিউলটি ক্ষতিগ্রস্থের চিকিৎসা অখণ্ডতার উপর দৃষ্টি নিবদ্ধ করে। এটি বিভিন্ন নিরাপদ কৌশলগুলি শেখায়—ফায়ারম্যান ক্যারি থেকে অস্থায়ী স্ট্রেচার ব্যবহার করা পর্যন্ত—আহত ব্যক্তিকে তাদের অবস্থা, বিশেষ করে মেরুদণ্ড বা মাথার আঘাতগুলিকে খারাপ না করে স্থানান্তরিত করার জন্য। এটি কখন রোগীকে সরানো উচিত (শুধুমাত্র যদি পরিবেশ অনিরাপদ হয়) এবং সর্বনিম্ন চাপ দিয়ে কীভাবে এটি করতে হবে তা কভার করে।",
    "সাপের কামড় ও পশুর কামড় (Snake Bite & Animal Bite)": "এই গুরুত্বপূর্ণ মডিউলটি বিষাক্ত সাপের কামড় বা র‍্যাবিস হওয়ার সম্ভাবনাযুক্ত পশুর কামড়ের পরে নেওয়ার জন্য তাৎক্ষণিক, জীবন রক্ষাকারী পদক্ষেপগুলি শেখায়। এটি গুরুত্বপূর্ণ প্রাথমিক চিকিৎসা কার্যগুলি, কী করা উচিত নয় (যেমন ক্ষত কাটা), এবং অ্যান্টি-ভেনম বা প্রয়োজনীয় পোস্ট-এক্সপোজার চিকিত্সার জন্য চিকিৎসা সুবিধাগুলিতে দ্রুত পরিবহণের গুরুত্ব তুলে ধরে।",
    "দড়ি উদ্ধার কৌশল এবং তাৎক্ষণিক সরঞ্জাম (Rope Rescue Techniques & Improvisation)": "এই উন্নত মডিউলটি উল্লম্ব বা দুর্গম ভূখণ্ডে উদ্ধার অভিযানের জন্য প্রয়োজনীয় গিঁট, নোঙর করার স্থান এবং বিশেষ কৌশলগুলিকে অন্তর্ভুক্ত করে। আপনি ক্ষতিগ্রস্থ এবং উদ্ধারকারীদের নামানো এবং তোলার জন্য নিরাপদ ব্যবস্থা স্থাপন করতে দড়ি, হারনেস এবং মৌলিক তাৎক্ষণিক (improvisation) দক্ষতাগুলি কীভাবে সঠিকভাবে ব্যবহার করতে হয় তা শিখবেন।",
    "ঘরোয়া আগুনের বিপদ এবং সুরক্ষা (Domestic Fire Hazard and Safety)": "এই মডিউলটি বাড়ির পরিবেশে আগুন প্রতিরোধ এবং তাৎক্ষণিক প্রতিক্রিয়ার উপর দৃষ্টি নিবদ্ধ করে। এটি সাধারণ আগুনের ঝুঁকিগুলি (বৈদ্যুতিক ত্রুটি, রান্নার ঝুঁকি) সনাক্ত করা, আগুন নেভানোর যন্ত্রের জন্য PASS পদ্ধতি ব্যবহার করা, এবং, সবচেয়ে গুরুত্বপূর্ণভাবে, সবাই নিরাপদে বেরিয়ে এসেছে তা নিশ্চিত করার জন্য একটি স্পষ্ট পারিবারিক সরিয়ে নেওয়ার পরিকল্পনা তৈরি করা এবং অনুশীলন করা অন্তর্ভুক্ত।",
    "বন আগুনের বিপদ এবং সুরক্ষা (Forest Fire Hazard and Safety)": "এই মডিউলটি বনের আগুনের অনন্য গতিশীলতা কভার করে, প্রতিরোধ এবং বেঁচে থাকা উভয়ের উপর মনোযোগ দেয়। এটি আগুনের অনুকূল পরিস্থিতি কীভাবে চিহ্নিত করতে হয়, কাঠামোর চারপাশে প্রতিরক্ষামূলক স্থান তৈরি করা এবং আগুন-প্রবণ এলাকায় বাসিন্দাদের জন্য গুরুত্বপূর্ণ সরিয়ে নেওয়ার পদ্ধতি শেখায়। আগুনের আচরণ বোঝা এবং দ্রুত ছেড়ে যেতে প্রস্তুত থাকার উপর জোর দেওয়া হয়।",
    "রাসায়নিক জরুরী অবস্থা (Chemical Emergency)": "এই বিশেষ মডিউলটি বিপজ্জনক রাসায়নিকগুলির আকস্মিক বা ইচ্ছাকৃত মুক্তির জন্য আপনাকে প্রস্তুত করে। এটি সতর্কীকরণ সংকেতগুলি (প্ল্যাকার্ড বা অদ্ভুত গন্ধ মতো) সনাক্ত করা, তাৎক্ষণিক সরিয়ে নেওয়া বা জায়গায় আশ্রয় নেওয়ার (sheltering in place) গুরুত্ব, এবং একটি বিষাক্ত পদার্থের সংস্পর্শের পরে এক্সপোজার কমাতে মৌলিক দূষণমুক্তকরণ (decontamination) পদক্ষেপগুলিকে অন্তর্ভুক্ত করে।",
    "জৈবিক জরুরী অবস্থা (Biological Emergency)": "এই মডিউলটি সংক্রামক রোগ, জৈব সন্ত্রাসবাদ বা মহামারীর দ্বারা সৃষ্ট হুমকির উপর দৃষ্টি নিবদ্ধ করে। এটি লক্ষণগুলি সনাক্ত করা, বিচ্ছিন্নতা (isolation) এবং সঙ্গনিরোধের (quarantine) গুরুত্ব, এবং রোগজীবাণুগুলির বিস্তার রোধ করার জন্য প্রয়োজনীয় স্বাস্থ্যবিধি অভ্যাসগুলি (যেমন হাত ধোয়া এবং মাস্ক পরা), একটি জৈবিক ঘটনার সময় সম্প্রদায়ের স্বাস্থ্য নিশ্চিত করা অন্তর্ভুক্ত।",
    "তেজস্ক্রিয় জরুরী অবস্থা এবং পারমাণবিক (Radiological Emergencies & Nuclear)": "এই উচ্চ-ঝুঁকিপূর্ণ মডিউলটি ক্ষতিকারক তেজস্ক্রিয়তার সাথে জড়িত ইভেন্টগুলির জন্য, যেমন ডার্টি বোমা বা পারমাণবিক ঘটনার জন্য আপনাকে প্রস্তুত করে। এটি সহজ, তাৎক্ষণিক সুরক্ষামূলক পদক্ষেপগুলির বিবরণ দেয়: ভেতরে যান, ভেতরে থাকুন এবং সংযুক্ত থাকুন (Shelter in Place)। এটি কীভাবে এক্সপোজার কমিয়ে আনা যায় এবং সরকারি সতর্কতা ও দ্রুত জনবিজ্ঞপ্তির গুরুত্বপূর্ণ ভূমিকা কী তা ব্যাখ্যা করে।"
=======
{
    "দুর্যোগ ব্যবস্থাপনা এবং প্রস্তুতি (DM AND PREPAPAREDNESS)": "দুর্যোগ ব্যবস্থাপনা (DM)-কে চারটি প্রধান পর্যায়ে সরল করা হয়েছে: হ্রাসকরণ (Mitigation), প্রস্তুতি (Preparedness), প্রতিক্রিয়া (Response), এবং পুনরুদ্ধার (Recovery)। এই মডিউলটি ভারতের নির্দিষ্ট দুর্বলতাগুলি তুলে ধরে এবং দেশের সুরক্ষার জন্য আইনি ভিত্তি—DM আইন 2005—এবং NDMA ও NDRF-এর মতো প্রধান সংস্থাগুলিকে পরিচয় করিয়ে দেয়, যারা এই প্রচেষ্টার নেতৃত্ব দেয়। সবচেয়ে গুরুত্বপূর্ণ, এটি আপনার পরিবারকে যেকোনো সংকটের জন্য প্রস্তুত করার জন্য সহজ, ব্যবহারিক পদক্ষেপ সরবরাহ করে, যেমন পালানোর পথ পরিকল্পনা করা এবং একটি সারভাইভাল কিট একত্রিত করা।",
    "ভূমিকম্প (EARTHQUAKE)": "এই শিক্ষামূলক ভিডিওটি অসমীয়া ভাষায় ভূমিকম্পের উপর একটি গভীর নির্দেশিকা। এটি বৈজ্ঞানিক কারণ (চলমান টেকটোনিক প্লেট), কীভাবে ভূমিকম্পের তীব্রতা রিখটার স্কেলে পরিমাপ করা হয়, এবং এর ভূমিকম্প অঞ্চলগুলির (Seismic Zones) মাধ্যমে ভারতের ঝুঁকি প্রোফাইল ব্যাখ্যা করে। সবচেয়ে গুরুত্বপূর্ণ, ভিডিওটি ব্যাপক নিরাপত্তা নির্দেশাবলী প্রদান করে—একটি ভূকম্পনজনিত ঘটনার ঠিক আগে, সময়কালে (নত হোন, ঢেকে নিন এবং ধরে রাখুন - Drop, Cover, and Hold On), এবং পরে বিভিন্ন পরিবেশে কী করতে হবে।",
    "ভূমিধস (LANDSLIDE)": "অসমীয়া ভাষায় উপস্থাপিত এই শিক্ষামূলক ভিডিওটি ভূমিধসের উপর একটি ব্যাপক নির্দেশিকা। এটি ভূমিধসের সংজ্ঞা দেয়, তাদের ছয়টি শ্রেণীতে বিভক্ত করে এবং দ্বৈত কারণগুলি ব্যাখ্যা করে: প্রাকৃতিক কারণ (যেমন ভারী বৃষ্টি এবং ভূমিকম্প) এবং মানুষের কার্যকলাপ (যেমন বন উজাড় এবং খনন)। ভিডিওটি ভূমিধসের কারণে হওয়া গুরুতর ক্ষতির বিবরণ দেয় এবং রিটেইনিং ওয়াল তৈরি করা এবং বনায়ন-এর মতো হ্রাসকরণ (Mitigation) কৌশলগুলির উপর জোর দেয়। সবচেয়ে গুরুত্বপূর্ণভাবে, ভূমিধসের আগে (প্রস্তুতি নিন), সময়কালে (উঁচু ভূমিতে সরিয়ে যান), এবং পরে কী করতে হবে তার একটি সম্পূর্ণ নিরাপত্তা নির্দেশিকা এটি প্রদান করে।",
    "বন্যা (FLOOD)": "এই শিক্ষামূলক ভিডিওটি বন্যার (Ban Pani) জন্য একটি গুরুত্বপূর্ণ নির্দেশিকা। এটি এর কারণগুলি (ভারী বৃষ্টিপাত, দুর্বল নিষ্কাশন), প্রকারগুলি (আকস্মিক বন্যা - Flash Floods, নদীর উপচে পড়া), এবং বন্যার গুরুতর প্রভাবগুলি চিহ্নিত করে। ভিডিওটি মূল সুরক্ষা কৌশলগুলির উপর জোর দেয়: একটি জরুরী কিট প্রস্তুত করা, বাঁধ (embankments) এর মতো হ্রাসকরণ কৌশলগুলি ব্যবহার করা, এবং সবচেয়ে গুরুত্বপূর্ণভাবে, বন্যার সময়কালে অবিলম্বে উঁচু ভূমিতে সরে যাওয়ার মাধ্যমে বন্যার জল এড়ানোর জীবন রক্ষাকারী নিয়ম অনুসরণ করা।",
    "সুনামি (TSUNAMI)": "এই ভিডিওটি সুনামি বোঝা এবং সেগুলোর হাত থেকে বাঁচার জন্য আপনার অপরিহার্য নির্দেশিকা। এটি এই বিশাল, জীবনঘাতী তরঙ্গগুলির পেছনের বিজ্ঞানকে ভেঙে দেয়, ব্যাখ্যা করে যে তারা প্রধানত টেকটোনিক প্লেট সরানোর কারণে সৃষ্ট বিশাল পানির নিচের ভূমিকম্পের ফলে হয়। সবচেয়ে বড় শিক্ষা? আপনাকে প্রাকৃতিক সতর্কীকরণ সংকেত জানতে হবে। আপনি উপকূলের কাছাকাছি থাকলে এবং সমুদ্রের জল হঠাৎ পিছিয়ে গেলে (টেনে নিলে), উঁচু ভূমিতে দৌড়ানোর জন্য এটি আপনার তাৎক্ষণিক, জীবন রক্ষাকারী সংকেত! সরকারি সতর্কতার জন্য অপেক্ষা করবেন না।",
    "ঘূর্ণিঝড় (Cyclone)": "এই ভিডিওটি ঘূর্ণিঝড়ের (Ghurṇibataha) জন্য একটি সংক্ষিপ্ত কিন্তু গুরুত্বপূর্ণ নির্দেশিকা প্রদান করে। এটি ক্রান্তীয় ঘূর্ণিঝড় গঠন এবং এর ধ্বংসাত্মক প্রকৃতিকে অন্তর্ভুক্ত করে, শক্তিশালী বাতাস এবং ঝড় বৃদ্ধির (storm surges) মাধ্যমে তাদের প্রভাব ব্যাখ্যা করে। এই মডিউলটি বিপদ ট্র্যাক করতে ব্যবহৃত চার-পর্যায়ের জাতীয় সতর্কীকরণ ব্যবস্থার বিবরণ দেয়। সবচেয়ে গুরুত্বপূর্ণ, এটি প্রস্তুতির উপর স্পষ্ট নির্দেশাবলী দেয়: প্রথমে আপনার বাড়িকে সুরক্ষিত করা, ঝড়ের \"চোখ\" চলাকালীন আপনার আশ্রয় ছেড়ে না যাওয়ার গুরুত্বপূর্ণ সতর্কতা, এবং ঘূর্ণিঝড় পেরিয়ে যাওয়ার পরে কী কী পদক্ষেপ নিতে হবে।",
    "মেঘভাঙা বৃষ্টি (CLOUDBURST)": "এটি মেঘভাঙা বৃষ্টিকে একটি সীমিত এলাকায় এক ঘন্টায় 100mm বৃষ্টির দ্রুত সঞ্চয় হিসাবে সংজ্ঞায়িত করে, ব্যাখ্যা করে যে এটি আটকে পড়া এবং ভেঙে পড়া তীব্র আর্দ্রতার কারণে ঘটে। তাৎক্ষণিক এবং সবচেয়ে গুরুতর বিপদ হলো এই ঘটনাগুলি হঠাৎ, বিপর্যয়মূলক আকস্মিক বন্যা (Flash Floods) এবং ভূমিধস সৃষ্টি করে। এই মডিউলটি সম্পূর্ণভাবে তাৎক্ষণিক সুরক্ষার উপর দৃষ্টি নিবদ্ধ করে: এটি হ্রাসকরণের (যেমন গাছ লাগানো) প্রয়োজনীয়তা এবং সরকারি সতর্কতার জন্য অপেক্ষা না করে, ভারী বৃষ্টির প্রথম লক্ষণগুলিতেই উঁচু ভূমিতে তাৎক্ষণিক সরিয়ে নেওয়ার গুরুত্বপূর্ণ পদক্ষেপের উপর জোর দেয়।",
    "বজ্রপাত ও ঝড় (LIGHTNING AND THUNDERSTORM)": "এই ভিডিওটি বজ্রপাত এবং ঝড়ের (Hawa-o Bijli) হাত থেকে বাঁচার জন্য একটি সংক্ষিপ্ত এবং গুরুত্বপূর্ণ নির্দেশিকা প্রদান করে। ⚡ এটি বিজ্ঞানকে স্পষ্টভাবে ব্যাখ্যা করে, বিদ্যুৎ (electrical strike) এবং বজ্র (sonic boom) এর মধ্যে পার্থক্য করে। মডিউলটির মূল অংশ সুরক্ষার উপর দৃষ্টি নিবদ্ধ করে, 30/30 নিয়ম ব্যবহারের উপর জোর দেয়: আপনি যদি বিদ্যুৎ দেখতে পান এবং 30 সেকেন্ডের মধ্যে বজ্রপাত শুনতে পান, তবে অবিলম্বে একটি নিরাপদ আশ্রয় (যেমন একটি আবদ্ধ ভবন বা বন্ধ গাড়ি) খুঁজুন এবং শেষ বজ্রপাতের পরে 30 মিনিট পর্যন্ত সেই আশ্রয়টি ছেড়ে যাবেন না। এটি বাড়ির ভেতরে থাকাকালীনও জল, কর্ডযুক্ত ফোন এবং কংক্রিটের মেঝেগুলির মতো পরিবাহী (conductive) উপাদান ব্যবহার না করার বিষয়ে সতর্ক করে।",
    "খরা (DROUGHT)": "এটি খরাকে অপর্যাপ্ত বৃষ্টিপাতের একটি দীর্ঘ সময়কাল হিসাবে সংজ্ঞায়িত করে যা একটি গুরুত্বপূর্ণ জলবাহী ভারসাম্যহীনতা (hydrological imbalance) সৃষ্টি করে, যার ফলে জলের ঘাটতি, ফসলের ক্ষতি এবং মাটির আর্দ্রতা হ্রাস পায়। মডিউলটি তখন খরার চারটি ভিন্ন প্রকারের— আবহাওয়াগত (Meteorological), কৃষিগত (Agricultural), জলবাহী (Hydrological), এবং সামাজিক-অর্থনৈতিক (Socio-economic)—বিবরণ দেয়, যা জীবনের বিভিন্ন দিকগুলিতে জলের ঘাটতির অগ্রগতি এবং প্রভাব বর্ণনা করে। সবচেয়ে গুরুত্বপূর্ণভাবে, ভিডিওটি সক্রিয় সমাধানের উপর মনোযোগ দেয়, শুষ্ক অবস্থার প্রভাব কমাতে ইনডোর এবং আউটডোর জল সংরক্ষণের পদ্ধতিগুলির উপর ব্যাপক, ব্যবহারিক পরামর্শ প্রদান করে, যা ছোট, দৈনন্দিন পরিবর্তনগুলির উপর জোর দেয় যা সম্মিলিতভাবে উল্লেখযোগ্য পরিমাণে জল বাঁচায়।",
    "তাপপ্রবাহ (Heat Wave)": "এই মডিউলটি তাপপ্রবাহকে (Heat Wave) অতিরিক্ত উচ্চ তাপমাত্রার সময়কাল হিসাবে সংজ্ঞায়িত করে, এর কারণ এবং হিট স্ট্রোক এবং পানিশূন্যতা (dehydration) এর মতো বিপজ্জনক স্বাস্থ্য প্রভাবগুলির বিবরণ দেয়। এটি গুরুত্বপূর্ণ সুরক্ষা ব্যবস্থার উপর দৃষ্টি নিবদ্ধ করে, যা তাপপ্রবাহের আগে, সময়কালে এবং পরে কী করতে হবে তা অন্তর্ভুক্ত করে, যেমন হাইড্রেটেড থাকা, হালকা কাপড় পরা এবং চরম সময়ের মধ্যে বাইরের কার্যকলাপ এড়ানো। লক্ষ্য সহজ: বিপদ চিনতে শিখুন এবং চরম গরম থেকে নিজেকে রক্ষা করুন।",
    "শৈত্যপ্রবাহ (Cold Wave)": "এই ভিডিওটি চরম ঠান্ডার প্রাণঘাতী প্রভাবগুলি সনাক্ত করা এবং তা থেকে কীভাবে বাঁচা যায় সে সম্পর্কে। এটি একটি শৈত্যপ্রবাহকে (Cold Wave) সংজ্ঞায়িত করে, এটি কীভাবে তৈরি হয় এবং হাইপোথার্মিয়া এবং ফ্রস্টবাইট (তুষারক্ষত)-এর মতো গুরুতর স্বাস্থ্য ঝুঁকিগুলি কভার করে। মডিউলটি প্রয়োজনীয় সুরক্ষামূলক ব্যবস্থা প্রদান করে, যার মধ্যে পোশাকের সঠিক স্তর, নিজের এবং অন্যের মধ্যে ঠান্ডা-সম্পর্কিত অসুস্থতার প্রাথমিক লক্ষণগুলি সনাক্ত করা, এবং একটি নিরাপদ, উষ্ণ আশ্রয় কখন এবং কীভাবে খুঁজতে হবে তা অন্তর্ভুক্ত।",
    "মৌলিক অনুসন্ধান ও উদ্ধার (Basic Search & Rescue)": "এই মডিউলটি দুর্যোগের সময় জীবন বাঁচানোর মূল নীতিগুলির সাথে আপনার পরিচয় করিয়ে দেয়। এটি একটি অনুসন্ধান এলাকা সংগঠিত করা, বিভিন্ন অনুসন্ধান প্যাটার্ন বোঝা, মৌলিক সরঞ্জাম ব্যবহার করা এবং ক্ষতিগ্রস্থদের অগ্রাধিকার দেওয়া-এর মতো প্রয়োজনীয় দক্ষতাগুলি কভার করে। মূল শিক্ষাটি হলো সুসংগঠিত কর্ম: ধসে পড়া কাঠামোর মতো বিপজ্জনক পরিবেশ থেকে ক্ষতিগ্রস্থদের নিরাপদে এবং দক্ষতার সাথে সনাক্ত করা, স্থিতিশীল করা এবং বের করে আনা শিখুন।",
    "ভার উত্তোলন এবং স্থিতিশীল করা (Lifting and Stabilising Load)": "এই প্রযুক্তিগত মডিউলটি উদ্ধার পরিস্থিতিতে ভারী জিনিসগুলি নিরাপদে পরিচালনা করার গুরুত্বপূর্ণ, প্রায়শই বিপজ্জনক দক্ষতা শেখায়। এটি উত্তোলনের পদার্থবিজ্ঞান, যান্ত্রিক সহায়তা (লিভার এবং সাধারণ কপিকল মতো) ব্যবহার, এবং, সবচেয়ে গুরুত্বপূর্ণভাবে, সেকেন্ডারি পতন এবং ক্ষতিগ্রস্থ এবং উদ্ধারকারী উভয়ের আরও আঘাত রোধ করতে একটি অস্থির লোডকে স্থিতিশীল করা (ক্রিবিং বা শোরিং ব্যবহার করে) অন্তর্ভুক্ত করে।",
    "সম্প্রদায় ভিত্তিক স্বাস্থ্য এবং প্রাথমিক চিকিৎসা (Community Based Health & First Aid)": "এই ব্যাপক মডিউলটি সম্প্রদায়ের পরিবেশে ব্যবহারিক প্রয়োগের উপর মনোযোগ দিয়ে, দৈনন্দিন জরুরি অবস্থার জন্য প্রয়োজনীয় মৌলিক প্রাথমিক চিকিৎসার দক্ষতা শেখায়। এতে ক্ষত পরিচর্যা, পোড়া ব্যবস্থাপনা, আঘাতের মূল্যায়ন, এবং পেশাদার সাহায্য আসার আগে প্রতিবেশী এবং পরিবারকে সাহায্য করার জন্য একটি সমন্বিত স্থানীয় প্রতিক্রিয়া সংগঠিত করা অন্তর্ভুক্ত।",
    "নরম টিস্যুর আঘাত (Soft Tissue Injuries)": "এই কেন্দ্রীভূত মডিউলটি ত্বক, পেশী, টেন্ডন এবং লিগামেন্টের সাথে জড়িত সাধারণ আঘাতগুলির মূল্যায়ন এবং তাৎক্ষণিক চিকিৎসা কভার করে। এটি মচকে যাওয়া এবং টান ধরার জন্য স্ট্যান্ডার্ড RICE প্রোটোকল (বিশ্রাম, বরফ, সংকোচন, উন্নতকরণ - Rest, Ice, Compression, Elevation), সেইসাথে সংক্রমণ রোধ করার জন্য খোলা ক্ষত এবং ঘর্ষণগুলির জন্য সঠিক পরিষ্কার এবং ব্যান্ডেজ করার কৌশল শেখায়।",
    "পেশী-কঙ্কাল আঘাত (Musculoskeletal Injury)": "এই মডিউলটি হাড় এবং জয়েন্টের আঘাত, যেমন ফ্র্যাকচার এবং স্থানচ্যুতি (dislocations) শনাক্ত করা এবং পরিচালনা করার বিষয়ে বিস্তারিত নির্দেশাবলী সরবরাহ করে। এটি আহত অঙ্গকে সুরক্ষিত করতে, ব্যথা কমাতে, এবং পরিবহণের সময় আরও ক্ষতি রোধ করতে স্লিংস এবং স্প্লিন্ট (এমনকি অস্থায়ী সরঞ্জাম) ব্যবহার করে অসাড় করা (immobilization) এর মতো গুরুত্বপূর্ণ দক্ষতা শেখায়।",
    "মৌলিক জীবন সমর্থন (Basic Life Support)": "তাৎক্ষণিক জীবন রক্ষাকারী দক্ষতার উপর এটি সবচেয়ে গুরুত্বপূর্ণ মডিউল। পেশাদার সাহায্য না আসা পর্যন্ত জীবন বজায় রাখার জন্য প্রয়োজনীয় কর্মের মূল ক্রমটি এটি শেখায়, কার্ডিওপালমোনারি রিসাসিটেশন (CPR) এবং শ্বাসরোধ এবং আকস্মিক কার্ডিয়াক অ্যারেস্টের মতো পরিস্থিতিগুলি সনাক্ত করা এবং পরিচালনা করার উপর ভারী মনোযোগ কেন্দ্রীভূত করে।",
    "রোগীকে তোলা ও সরানো (Lifting & Moving Patient)": "এই মডিউলটি ক্ষতিগ্রস্থের চিকিৎসা অখণ্ডতার উপর দৃষ্টি নিবদ্ধ করে। এটি বিভিন্ন নিরাপদ কৌশলগুলি শেখায়—ফায়ারম্যান ক্যারি থেকে অস্থায়ী স্ট্রেচার ব্যবহার করা পর্যন্ত—আহত ব্যক্তিকে তাদের অবস্থা, বিশেষ করে মেরুদণ্ড বা মাথার আঘাতগুলিকে খারাপ না করে স্থানান্তরিত করার জন্য। এটি কখন রোগীকে সরানো উচিত (শুধুমাত্র যদি পরিবেশ অনিরাপদ হয়) এবং সর্বনিম্ন চাপ দিয়ে কীভাবে এটি করতে হবে তা কভার করে।",
    "সাপের কামড় ও পশুর কামড় (Snake Bite & Animal Bite)": "এই গুরুত্বপূর্ণ মডিউলটি বিষাক্ত সাপের কামড় বা র‍্যাবিস হওয়ার সম্ভাবনাযুক্ত পশুর কামড়ের পরে নেওয়ার জন্য তাৎক্ষণিক, জীবন রক্ষাকারী পদক্ষেপগুলি শেখায়। এটি গুরুত্বপূর্ণ প্রাথমিক চিকিৎসা কার্যগুলি, কী করা উচিত নয় (যেমন ক্ষত কাটা), এবং অ্যান্টি-ভেনম বা প্রয়োজনীয় পোস্ট-এক্সপোজার চিকিত্সার জন্য চিকিৎসা সুবিধাগুলিতে দ্রুত পরিবহণের গুরুত্ব তুলে ধরে।",
    "দড়ি উদ্ধার কৌশল এবং তাৎক্ষণিক সরঞ্জাম (Rope Rescue Techniques & Improvisation)": "এই উন্নত মডিউলটি উল্লম্ব বা দুর্গম ভূখণ্ডে উদ্ধার অভিযানের জন্য প্রয়োজনীয় গিঁট, নোঙর করার স্থান এবং বিশেষ কৌশলগুলিকে অন্তর্ভুক্ত করে। আপনি ক্ষতিগ্রস্থ এবং উদ্ধারকারীদের নামানো এবং তোলার জন্য নিরাপদ ব্যবস্থা স্থাপন করতে দড়ি, হারনেস এবং মৌলিক তাৎক্ষণিক (improvisation) দক্ষতাগুলি কীভাবে সঠিকভাবে ব্যবহার করতে হয় তা শিখবেন।",
    "ঘরোয়া আগুনের বিপদ এবং সুরক্ষা (Domestic Fire Hazard and Safety)": "এই মডিউলটি বাড়ির পরিবেশে আগুন প্রতিরোধ এবং তাৎক্ষণিক প্রতিক্রিয়ার উপর দৃষ্টি নিবদ্ধ করে। এটি সাধারণ আগুনের ঝুঁকিগুলি (বৈদ্যুতিক ত্রুটি, রান্নার ঝুঁকি) সনাক্ত করা, আগুন নেভানোর যন্ত্রের জন্য PASS পদ্ধতি ব্যবহার করা, এবং, সবচেয়ে গুরুত্বপূর্ণভাবে, সবাই নিরাপদে বেরিয়ে এসেছে তা নিশ্চিত করার জন্য একটি স্পষ্ট পারিবারিক সরিয়ে নেওয়ার পরিকল্পনা তৈরি করা এবং অনুশীলন করা অন্তর্ভুক্ত।",
    "বন আগুনের বিপদ এবং সুরক্ষা (Forest Fire Hazard and Safety)": "এই মডিউলটি বনের আগুনের অনন্য গতিশীলতা কভার করে, প্রতিরোধ এবং বেঁচে থাকা উভয়ের উপর মনোযোগ দেয়। এটি আগুনের অনুকূল পরিস্থিতি কীভাবে চিহ্নিত করতে হয়, কাঠামোর চারপাশে প্রতিরক্ষামূলক স্থান তৈরি করা এবং আগুন-প্রবণ এলাকায় বাসিন্দাদের জন্য গুরুত্বপূর্ণ সরিয়ে নেওয়ার পদ্ধতি শেখায়। আগুনের আচরণ বোঝা এবং দ্রুত ছেড়ে যেতে প্রস্তুত থাকার উপর জোর দেওয়া হয়।",
    "রাসায়নিক জরুরী অবস্থা (Chemical Emergency)": "এই বিশেষ মডিউলটি বিপজ্জনক রাসায়নিকগুলির আকস্মিক বা ইচ্ছাকৃত মুক্তির জন্য আপনাকে প্রস্তুত করে। এটি সতর্কীকরণ সংকেতগুলি (প্ল্যাকার্ড বা অদ্ভুত গন্ধ মতো) সনাক্ত করা, তাৎক্ষণিক সরিয়ে নেওয়া বা জায়গায় আশ্রয় নেওয়ার (sheltering in place) গুরুত্ব, এবং একটি বিষাক্ত পদার্থের সংস্পর্শের পরে এক্সপোজার কমাতে মৌলিক দূষণমুক্তকরণ (decontamination) পদক্ষেপগুলিকে অন্তর্ভুক্ত করে।",
    "জৈবিক জরুরী অবস্থা (Biological Emergency)": "এই মডিউলটি সংক্রামক রোগ, জৈব সন্ত্রাসবাদ বা মহামারীর দ্বারা সৃষ্ট হুমকির উপর দৃষ্টি নিবদ্ধ করে। এটি লক্ষণগুলি সনাক্ত করা, বিচ্ছিন্নতা (isolation) এবং সঙ্গনিরোধের (quarantine) গুরুত্ব, এবং রোগজীবাণুগুলির বিস্তার রোধ করার জন্য প্রয়োজনীয় স্বাস্থ্যবিধি অভ্যাসগুলি (যেমন হাত ধোয়া এবং মাস্ক পরা), একটি জৈবিক ঘটনার সময় সম্প্রদায়ের স্বাস্থ্য নিশ্চিত করা অন্তর্ভুক্ত।",
    "তেজস্ক্রিয় জরুরী অবস্থা এবং পারমাণবিক (Radiological Emergencies & Nuclear)": "এই উচ্চ-ঝুঁকিপূর্ণ মডিউলটি ক্ষতিকারক তেজস্ক্রিয়তার সাথে জড়িত ইভেন্টগুলির জন্য, যেমন ডার্টি বোমা বা পারমাণবিক ঘটনার জন্য আপনাকে প্রস্তুত করে। এটি সহজ, তাৎক্ষণিক সুরক্ষামূলক পদক্ষেপগুলির বিবরণ দেয়: ভেতরে যান, ভেতরে থাকুন এবং সংযুক্ত থাকুন (Shelter in Place)। এটি কীভাবে এক্সপোজার কমিয়ে আনা যায় এবং সরকারি সতর্কতা ও দ্রুত জনবিজ্ঞপ্তির গুরুত্বপূর্ণ ভূমিকা কী তা ব্যাখ্যা করে।"
>>>>>>> origin/main
}