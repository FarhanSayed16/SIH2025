# Flutter Mobile App Environment Variables

# Backend API Base URL (without /api suffix)
# Localhost (desktop only): http://localhost:3000
# Android emulator: http://10.0.2.2:3000
# Physical phone on same Wi-Fi: http://YOUR_PC_LAN_IP:3000
# Deployed Render: https://kavach-backend-nyub.onrender.com
BASE_URL=http://192.168.0.104:3000

# Socket.io Server URL (without /api suffix)
SOCKET_URL=http://192.168.0.104:3000

# API Version
API_VERSION=v1

# Environment (development/production)
ENVIRONMENT=development

# Gemini API Key for AI features
GEMINI_API_KEY=your-gemini-api-key
